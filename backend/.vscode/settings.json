{
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,

    "python.analysis.typeCheckingMode": "strict",
    "python.languageServer": "Pylance",

    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },

    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/*.pyo": true,
        "**/*.pyd": true,

        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.mypy_cache": true,
        "**/.pyright": true,

        "**/.coverage": true,
        "**/.coverage.*": true,
        "**/htmlcov": true,

        "**/.tox": true,
        "**/.nox": true,

        "**/.venv": true,
        "**/venv": true,

        "**/*.egg-info": true,
        "**/.eggs": true,

        "**/dist": true,
        "**/build": true
    },

    "search.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.mypy_cache": true,
        "**/.venv": true,
        "**/venv": true,
        "**/htmlcov": true,
        "**/dist": true,
        "**/build": true
    },

    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.venv/**": true,
        "**/venv/**": true
    }
}